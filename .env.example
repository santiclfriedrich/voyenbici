# Plantilla. Copiar a .env SOLO si vas a correr el panel local con `netlify dev`.
# El .env esta en .gitignore y no debe subirse nunca.
# En produccion estos valores se cargan en Netlify, no en un archivo.

ADMIN_USER=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=mateoghidini1998/voy-en-bici

# OJO: si aca ponés main, guardar desde el panel local commitea al repo real
# y publica en el sitio en vivo. Para probar sin afectar produccion, crear una
# rama de prueba y apuntar aca.
GITHUB_BRANCH=main
